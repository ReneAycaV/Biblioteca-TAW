# Copia este archivo como .env
PORT=3002

# Clave que el backend envía para obtener un token (debe ser igual a PAGOS_PRIVATE_KEY en backend/.env)
PAGOS_PRIVATE_KEY=cambia-esta-clave

# Resultado de cada pago nuevo:
#   APROBAR   se aprueba al instante (lo normal para usar la app)
#   PENDIENTE queda pendiente y se aprueba o rechaza a mano en el panel (http://localhost:3002)
#   RECHAZAR  se rechaza siempre (para probar el caso de error)
MODO=APROBAR
