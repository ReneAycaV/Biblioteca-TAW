# Copia este archivo como .env (en Vercel, crea estas mismas variables en el proyecto)
PORT=3002

# Clave que el backend envía para obtener un token (debe ser igual a PAGOS_PRIVATE_KEY del backend)
PAGOS_PRIVATE_KEY=cambia-esta-clave

# Resultado de cada pago nuevo:
#   APROBAR   se aprueba al instante (lo normal para usar la app)
#   PENDIENTE queda pendiente y se aprueba o rechaza a mano en el panel
#   RECHAZAR  se rechaza siempre (para probar el caso de error)
MODO=APROBAR

# Base de datos donde se guardan las órdenes (tabla "pagos", se crea sola).
# Son las mismas 5 variables del backend. Obligatorias en Vercel; en el PC, si se omiten,
# las órdenes se guardan en data/ordenes.json. También se acepta DATABASE_URL en su lugar.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=postgres
