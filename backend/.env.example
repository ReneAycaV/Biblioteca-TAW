# Copia este archivo como .env y completa los valores reales (nunca subas .env al repositorio)
PORT=3000

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

JWT_SECRET=
JWT_EXPIRES_IN=1d

PAGOS_BASE_URL=
PAGOS_PRIVATE_KEY=

# ── Recomendadores con IA ──
# Proveedor: gemini (gratis, por defecto) | openrouter (modelos gratis ":free") | groq (gratis) | ollama (local, sin clave) | anthropic (Claude, pagado)
IA_PROVEEDOR=gemini
# Clave del proveedor. Gemini: https://aistudio.google.com → Get API key | OpenRouter: https://openrouter.ai/keys
# Si queda vacía, los recomendadores funcionan en "modo respaldo" (reglas, sin IA).
IA_API_KEY=
# Modelo (opcional; varios separados por coma = se prueba el siguiente si uno está saturado).
# Por defecto: gemini-3.5-flash-lite,gemini-flash-lite-latest | openrouter/free,google/gemma-4-31b-it:free | llama-3.3-70b-versatile | llama3.2 | claude-haiku-5-5
IA_MODEL=
# Tiempo máximo de espera de la IA en milisegundos antes de usar el respaldo
IA_TIMEOUT_MS=15000
